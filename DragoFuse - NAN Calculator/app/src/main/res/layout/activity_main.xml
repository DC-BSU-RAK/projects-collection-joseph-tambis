<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/bg_main">

    <ImageButton
        android:id="@+id/btnInfo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="Info"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_info_details"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/hatcheryArea"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/hatchery_bg"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnInfo"
        app:layout_constraintBottom_toTopOf="@+id/eggGrid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgResult"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_help" />

        <TextView
            android:id="@+id/txtResultName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Two Eggs"
            android:textColor="#333333"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/eggGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/hatcheryArea"
        app:layout_constraintBottom_toTopOf="@+id/btnCombine"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFire"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="105dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="Fire"
                app:icon="@drawable/ic_egg_fire"
                app:iconGravity="top"
                app:iconSize="40dp"
                app:iconTint="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIce"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="105dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="Ice"
                app:icon="@drawable/ic_egg_ice"
                app:iconGravity="top"
                app:iconSize="40dp"
                app:iconTint="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNature"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="105dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="Nature"
                app:icon="@drawable/ic_egg_nature"
                app:iconGravity="top"
                app:iconSize="40dp"
                app:iconTint="@null" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnElectric"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="105dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="Electric"
                app:icon="@drawable/ic_egg_electric"
                app:iconGravity="top"
                app:iconSize="40dp"
                app:iconTint="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoid"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="105dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="Void"
                app:icon="@drawable/ic_egg_void"
                app:iconGravity="top"
                app:iconSize="40dp"
                app:iconTint="@null" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnCombine"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Combine Eggs"
        app:layout_constraintTop_toBottomOf="@id/eggGrid"
        app:layout_constraintBottom_toTopOf="@+id/btnReset"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnReset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reset Selection"
        android:backgroundTint="@android:color/holo_red_dark"
        app:layout_constraintTop_toBottomOf="@id/btnCombine"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>